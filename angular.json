{
 "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
 "version": 1,
 "projects": {
  "inbox-media-web": {
   "projectType": "application",
   "root": "",
   "sourceRoot": "src",
   "prefix": "app",
   "architect": {
    "build": {
     "builder": "@angular-devkit/build-angular:application",
     "options": {
      "outputPath": "dist/inbox-media-web",
      "index": "src/index.html",
      "browser": "src/main.ts",
      "polyfills": [
       "zone.js"
      ],
      "tsConfig": "tsconfig.app.json",
      "styles": [
       "src/styles.css"
      ],
      "assets": [
       {
        "glob": "**/*",
        "input": "public"
       }
      ]
     },
     "configurations": {
      "production": {
       "outputHashing": "all"
      },
      "development": {
       "optimization": false,
       "sourceMap": true
      }
     },
     "defaultConfiguration": "production"
    },
    "serve": {
     "builder": "@angular-devkit/build-angular:dev-server",
     "configurations": {
      "production": {
       "buildTarget": "inbox-media-web:build:production"
      },
      "development": {
       "buildTarget": "inbox-media-web:build:development"
      }
     },
     "defaultConfiguration": "development"
    }
   }
  }
},
"cli": {
  "analytics": false
}
}